#!/bin/bash
. /usr/local/save-changesnew/rntchangesfunctions
. /usr/local/save-changesnew/save-changesnewfnts
fmt="%Y-%m-%d %H:%M:%S"
prefix=mainloop1
prefixt=mainloop2
prefixth=cache1

atmp="$1"
checkSUM="$2"
checkMETHOD="$3"
# [[ "$3" = "batch2" ]] && prefix=mainloop3 && prefixt=mainloop4 && prefixth=cache2  # if interleaving
SORTCOMPLETE="$4"
NFS="$5"
CACHE_F="$6"
deltadiff=$7
CSZE=$8
shift 8

## $atmp "false" "main" "batch2"
#SORTCOMPLETE="${atmp}/${prefix}_${RANDOM}$(rand_alpha)$$_tmp.log"  # if interleaving
#NFS="${atmp}/${prefixt}_${RANDOM}$(rand_alpha)$$_tmp.log"  # if interleaving
#CACHE="${atmp}/${prefixth}_${RANDOM}$(rand_alpha)$$_tmp.log"  # if interleaving
is_sum="false"
get_hashmethod "mainloop"

if [ "$CSZE" -ge 0 ] 2>/dev/null; then
    for f in "$@"; do

        sblk "$f" $SORTCOMPLETE $NFS $checkSUM $CSZE $CACHE $deltadiff
    done
else
    echo "mainloop Incorrect arguments supplied"
fi

