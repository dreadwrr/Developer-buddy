[[ ! -d $ch ]] && drive="/" || if ! grep -Eiq "Artix|Porteus" /etc/os-release; then [[ "$drive" != "/" ]] && { drive="/" ; echo "not porteus defaulting to $drive" ; } ; else isporteus="true" ; [[ "$drive" != "/" ]] && TAIL+=(! -name '.wh.*') ; fi


