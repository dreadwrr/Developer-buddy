mkdir $tmp
mkdir $tmp$workdir
mkdir $atmp
mkdir $atmp$workfld
mkdir $atmp$workdir
intst

if [ "$1" == "search" ]; then
    search="true"
    THETIME="$argtwo"

else    
    THETIME="$argone"
    start=$(date +%s.%N)
    [ "$THETIME" == "SRC" ] &&{ SRCDIR=$THETIME; THETIME="$argtwo"; }  # shift
    if [ "$2" == "SRC" ]; then
        SRCDIR=$2
    elif [ "$2" == "SEARCH" ] || [ "$2" == "search" ]; then
        echo "Exiting not a search" && exit
    fi

fi

if [ "$argf" == "filtered" ]; then
    filtered="true"
    astring=" filtered"
fi

if [ "$THETIME" != "noarguser" ]; then
    p=60
    if [ "$THETIME" -ge 0 ] 2>/dev/null; then
        argone=$THETIME
        search_time=$argone
        search_string="files $2 seconds old or newer"
        tmn=$( convertn $argone $p)

    else
        argone=".txt"
        test -d "$passdir" || { echo "Invalid argument $passdir . PWD required."; exit 1; }
        cd "$passdir"  || exit
        filename="$argtwo"
        test -f "$filename" || { test -d "$filename" || echo no such directory file or integer; exit 1; }
        parseflnm="${argtwo##*/}"
        if [ "$parseflnm" == "" ]; then parseflnm="$(echo "$argtwo" | sed -e 's/\/$//' -e 's@.*/@@')" ; fi
        cyan "searching for files newer than $filename "

        if [ "$filtered" == "true" ]; then
            filtered="false"
            astring=""
        else
            astring="filtered"
            filtered="true"
        fi
        file_path="$passdir/$parseflnm"
        flsrh="true"
        ct=$(date +%s)
        frmt=$(stat -c %Y "$filename")
        ag=$(( ct - frmt ))
        search_time=$ag
        search_string="files newer than $filename"
        deltadiff=$( timedelta $STRTTIME $ag 6)
        ag=$( convertn $ag $p)
        MMIN=(-newer "$filename")
        CMIN=(-cmin "-$ag")
    fi
else
    search_string="files 5 minutes old or newer"
    argone="5" ; tmn=$argone ; search_time=300
fi

cyan "searching for$astring $search_string"

if [ "$tmn" != "" ]; then
    MMIN=(-mmin "-$tmn")
    CMIN=(-cmin "-$tmn")
fi
findrelavant
findfiles

if [ -s $SORTCOMPLETE ]; then

    sort -u -o $SORTCOMPLETE $SORTCOMPLETE

    inclusions $SORTCOMPLETE

    if [ "$flsrh" != "true" ]; then
        s=${STRTTIME%%.*}
        RANGE=$(( s + search_time ))  # filter out non existant files ect
        PRD=$(date -d "@$RANGE" +"$fmt")
        awk -v tme="$PRD" '{ ts = $1 " " $2; if (ts <= tme) print }' $SORTCOMPLETE > $tout ; mv $tout $SORTCOMPLETE
    fi

    sort -u -o $SORTCOMPLETE $SORTCOMPLETE

    process_sort $SORTCOMPLETE $TMPOPT

    # cat $TMPOPT | grep ' /tmp/' > $TMPOUTPUT
    sort -o $TMPOUTPUT $TMPOUTPUT
    # sed -i '/\"\/tmp/d' $SORTCOMPLETE
    # sed -i '/ \/tmp/d' $TMPOPT
    sort -o $TMPOPT $TMPOPT

    cp $TMPOPT $RECENT
    /usr/local/recent-changes/filter $RECENT $USR

    logf=$TMPOPT
    if [ $filtered == "true" ]; then
        logf=$RECENT
    fi

    cd /tmp || exit
    MODULENAME=${chxzm:0:9}
    moduledir=$MODULENAME"_"$FLBRAND
    chxzmnm=$MODULENAME"manifest.txt"
    FLTOUT="/tmp"$MODULENAME"ItemsFilteredout"
	fileout="$XDG_RUNTIME_DIR"/file_output
    if [ "$flsrh" == "true" ]; then
        flnm="xNewerThan_$parseflnm"
        flnmdff="xDiffFromLast_$parseflnm"

    elif [ "$argf" == "filtered" ]; then
        flnm="xFltchanges_"$argone
        flnmdff="xFltDiffFromLastSearch_"$argone
    else
        flnm="xSystemchanges"$argone
        flnmdff="xSystemDiffFromLastSearch"$argone
    fi

    if [ "$search" == "false" ]; then
        dirSRC=/tmp  # recentchanges

        # SRC tag make .xzm from a root folder
        if [ "$SRCDIR" == "SRC" ]; then
            findrootfolder
        fi
    else
        dirSRC=$USRDIR  # recentchanges search
    fi

    difffile="$dirSRC$MODULENAME$flnmdff"

    # check for previous existing search to diff
    if [ -e "$dirSRC$MODULENAME$flnm" ]; then
        cp "$dirSRC$MODULENAME$flnm" $tmp && OLDSORTED="$tmp$MODULENAME$flnm"

    # if nothing was found
    elif [ "$flsrh" == "false" ]; then

        # if nothing found check in archived searches
        hsearch

    fi

    # Reset. move old searches
    clearlogs

    # send tmp results to user
    if [ -s $TMPOUTPUT ]; then
        cp $TMPOUTPUT $dirSRC$MODULENAME"xSystemTmpfiles$parseflnm"
        chown $USR $dirSRC$MODULENAME"xSystemTmpfiles$parseflnm"
    fi

    if [ -s $logf ]; then
         syschg="true"
        # Send search result sortcomplete to user
        cp $logf "$dirSRC$MODULENAME$flnm"
        chown $USR "$dirSRC$MODULENAME$flnm"
        echo "$dirSRC$MODULENAME$flnm" > $fileout  # holdspath to launch non-root
        chown $USR "$fileout"
        # Save current search in archive for next time
        mkdir /tmp$moduledir && chown $USR /tmp$moduledir  # formerly in clearlogs after trim
        cp $logf /tmp"$moduledir$MODULENAME$flnm"

        # prep OLDSORT
        # possible sort?

        # sed -i '/^[[:space:]]*$/d' $OLDSORTED  # remove blank lines

        # 07/24/2026
        # added sort -u -o $OLDSORTED $OLDSORTED
        [[ -n $OLDSORTED ]] && { sort -u -o $OLDSORTED $OLDSORTED ; nodiff="true" ; comm -23 "$OLDSORTED" $logf > "$difffile" ; }

        isdiff "$difffile" $TMPOPT $TMPCOMPLETE
        backend $argf
        filterhits $TMPOPT $flth
        postop $SORTCOMPLETE $0
        test -e "$difffile" && chown $USR "$difffile"
    fi
fi

