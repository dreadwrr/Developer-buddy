BRAND=$(date +"MDY_%m-%d-%y-TIME_%R" | tr ':' '_')
FLBRAND=$(date +"MDY_%m-%d-%y-TIME_%R_%S" | tr ':' '_')

STRTTIME=$(date +%s.%N)

file_path=""  # for flsrh inclusion to not list the file itself
SRCDIR=""															;	csm=""
dirSRC=""															;	OLDSORTED=""

ha_total_time=""												;	logger_total_time=""
lifetime_total=""												;	lifetime_time=""
