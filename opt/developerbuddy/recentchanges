declare -A recent  # this search SORTCOMPLETE
declare -A ref_map  # bash default mode. logs stored or original SORTCOMPLETE. past searches
declare -A created  # xrc inotify $log_file
declare -A rout_lines  # stats or actions that is output to diff file and stats gpg and table

CACHE_F="${cdir}ctimecache"
