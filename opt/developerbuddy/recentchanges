export _time=3600   # default xRC searches for 1 hour before closing. default is to clear file_creation_log
export min_span=3600  # set above _time to increase capacity. 0 would leave the log untouched

archivesrh=5                    # How many old searches to save that can then be grabbed by recentchanges search and recentchanges for comparisons in diff file
#Analytics
export ANALYTICSECT="true" # provides more feedback
                                            # total search time ect
