export defaultTHEME="dark"  # dark - default for sv azure ect
                                             # light

## Diagnostics
# slower useful if you want to check deeper level of stats
export checkSUM="true"    # compare file checksums for slight changes
                                         # slower useful if you want to check deeper level of stats
export checkMETHOD="md5ent"  # md5sum
                                                # md5ent - include entropy
                                                # b2sum - blake2 256 (note hash collision checks will be turned off)
                                                # b2ent - include entropy - blake2 256 (note hash collision checks will be turned off)

